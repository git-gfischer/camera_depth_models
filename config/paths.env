# Host side of the containers: which host directories are mounted where.
# Read by docker/docker-compose.yaml through the symlink docker/.env; relative
# paths are relative to docker/.
# Variables set in your shell override these.

# Datasets, mounted read-only at /data. Paths in dataset configs start with /data.
CDM_DATASETS=../data
# Checkpoints, ONNX files, engines and parity references, mounted at /models.
CDM_MODELS=../models
# Results (cdm_dataset output, RealSense recordings), mounted at /output.
CDM_OUTPUT=../output

# The user the dataset and engine services run as, so their files are yours:
# set these to the output of `id -u` and `id -g`.
CDM_UID=1000
CDM_GID=1000

# Config files the services use, from this directory (mounted at /config).
CDM_ENGINE_CONFIG=engine.yaml
CDM_DATASET_CONFIG=dataset.yaml
CDM_REALSENSE_CONFIG=realsense.yaml
